; ============================================================================
; x816_contract.inc -- the X816 contract constants, for as65816.
;
; GENERATED BY tools/contract.py -- DO NOT EDIT.
; Edit X816_core/tools/contract.py and run:  python tools/contract.py --write
;
; The Calypsi assembler runs the C preprocessor, so this is #included, not
; .included, and the expressions are C-style. Every symbol here is a .equ:
; defining one of these names again in the including file is a duplicate
; symbol error, which is the point -- a second definition is exactly the
; drift this file exists to stop.
; ============================================================================

#ifndef X816_CONTRACT_INC
#define X816_CONTRACT_INC

; ---- Image and load contract ---------------------------------------------
; Where the HPS loader drops an image, what marks it as one, and where control
; is handed to it. boot/boot.s, x816.sv's download path, exec.s and every
; linker script have to agree on all of it or a load lands on the zero page
; and the machine dies before it prints anything.
X816_PROG_BASE:      .equ    0x010000          ; loadable program image: OSD 'Load Image' and boot1.rom
X816_PROG_ENTRY:     .equ    0x010004          ; PROG_BASE + 4 -- the jmp in the image's own header
X816_FW_BASE:        .equ    0xf00000          ; resident kernel firmware image, boot2.rom (doc/KERNEL.md 3)
X816_FW_ENTRY:       .equ    0xf00004          ; FW_BASE + 4
X816_FW_FIRST_BANK:  .equ    0xf0              ; banks $F0-$FF are the firmware region, write-protected
X816_MAGIC_0:        .equ    0x58
X816_MAGIC_1:        .equ    0x38
X816_MAGIC_2:        .equ    0x31
X816_MAGIC_3:        .equ    0x36
X816_MAGIC_LE32:     .equ    0x36313858        ; the same four bytes as one little-endian 32-bit read
X816_IOCTL_PROG:     .equ    0x0040            ; MiSTer ioctl_index for boot1.rom (a program image)
X816_IOCTL_FW:       .equ    0x0080            ; MiSTer ioctl_index for boot2.rom (the kernel firmware)
X816_IOCTL_OSD_SLOT: .equ    0x01              ; ioctl_index[5:0] for an OSD file pick
X816_EXEC_STAGE:     .equ    0x100000          ; where `run` parks an image before relocating it over PROG_BASE
X816_EXEC_MAX:       .equ    0xff00            ; largest image exec.s's single-pass copy can move (X is 16 bits)

; ---- Kernel ABI -- table, context and error codes ------------------------
; doc/KERNEL.md sections 3-5. The table address is fixed forever; the kernel's
; bank-0 claim is carved out of every program's linker map so a program object
; cannot land on the kernel's direct page.
KERN_TABLE:      .equ    0x00fe00              ; 64 entries of `jmp long:`, one page
KERN_ENTRIES:    .equ    64                    ; entries in the table
KERN_ENTRY_SIZE: .equ    4                     ; bytes per entry -- a jmp long:
KERN_TABLE_END:  .equ    0x00feff              ; last byte of the table page
KERN_DP:         .equ    0x2000                ; the kernel's direct page; KENTER switches D here
KERN_STATE:      .equ    0x2000                ; start of the kernel's bank-0 claim (KERNEL.md 3.1)
KERN_STATE_END:  .equ    0x2fff                ; last byte of the claim

; ---- VERA2 framebuffer ---------------------------------------------------
; The 1 MB of flat SDRAM the VERA2 bitmap layer scans out, doc/VERA2.md. It
; sits directly below the firmware so the arena stays one contiguous run, and
; it is reserved WHETHER OR NOT the layer is enabled -- a heap end that moved
; with an OSD switch could not be a single-sourced constant, and a program
; built against the larger arena would corrupt the framebuffer the moment
; somebody turned the layer on. It is ordinary CPU memory: the framebuffer is
; written with plain stores and MVN block moves, not through a data port. What
; makes that work is that flat_sdram.sv maps this range TWO BYTES PER SDRAM
; WORD instead of one, so the scanout engine reads two pixels per access --
; 640x480 8bpp needs 320 accesses per line and a line only affords ~400.
; VFB_BASE is therefore not a free choice: its low 20 bits must be zero and
; map_addr() keys on bits [23:20]. 640x480 8bpp is 307,200 bytes, so 1 MB
; holds TWO of them -- double-buffering, which the upstream VERA2 this derives
; from could not do.
X816_VFB_BASE: .equ    0xe00000                ; first byte of the framebuffer region
X816_VFB_LAST: .equ    0xefffff                ; last byte, inclusive -- one byte below X816_FW_BASE
X816_VFB_SIZE: .equ    0x100000                ; 1 MB
X816_VFB_BANK: .equ    0xe0                    ; the bank map_addr() decodes on (VFB_BASE >> 16)

; ---- VERA2 bitmap layer --------------------------------------------------
; The register block at $9F60-$9F6F, doc/VERA2.md 3. The framebuffer itself is
; not here -- it is plain memory at X816_VFB_BASE -- so this is only the
; control surface: mode, display base and palette. ID is the feature test and
; it is three-valued on purpose. $B5 means the layer is present and the OSD
; switch is on; $00 means the switch is off (or, on a machine without the
; layer at all, open bus happens to read otherwise). A program must check for
; $B5 and say so when it does not find it, rather than silently drawing
; nothing.
X816_VERA2_BASE:      .equ    0x9f60           ; CTRL; the block runs to $9F6F
X816_VERA2_ID:        .equ    0x9f61           ; reads X816_VERA2_ID_VALUE
X816_VERA2_ID_VALUE:  .equ    0xb5             ; feature-detect signature
X816_VERA2_DISPL:     .equ    0x9f62           ; display base [7:0]; bit 0 reads 0
X816_VERA2_DISPM:     .equ    0x9f63           ; display base [15:8]
X816_VERA2_DISPH:     .equ    0x9f64           ; display base [19:16]
X816_VERA2_PALADR:    .equ    0x9f66           ; palette index, auto-increments
X816_VERA2_PALLO:     .equ    0x9f67           ; {G,B} latched
X816_VERA2_PALHI:     .equ    0x9f68           ; {-,R}; commits the entry, idx++
X816_VERA2_MODE_8BPP: .equ    1                ; CTRL[2:1] = 1: 640x480 256-colour
X816_VERA2_MODE_4BPP: .equ    2                ; CTRL[2:1] = 2: 640x480 16-colour

; ---- Kernel writable-data region -----------------------------------------
; Two MB of ordinary SDRAM the KERNEL owns and may write, doc/MEMORY_MAP.md
; 1.1. Its first and currently only tenant is the resident text editor's
; buffer; the kernel's own explicitly-placed `far` data (x816-kernel.scm's
; FarRAM) takes the first bank. It is named for the owner rather than the
; tenant so that the next kernel service needing SDRAM does not trigger a
; second reservation and another round of edits to every language's allocator.
; WHY IT IS NOT INSIDE THE FRAMEBUFFER, WHICH IS WHERE FarRAM USED TO BE.
; $E0-$EF is not ordinary memory: flat_sdram.sv maps that range TWO BYTES PER
; SDRAM WORD (map_addr(), keyed on cpu_a[23:20]) so the scanout engine reads
; two pixels per access. It is the one address range in the machine with a
; different decode, none of the SDRAM timing work was measured there, and the
; position of a framebuffer WITHIN the region is program-chosen through
; VERA2_DISPL/M/H -- so no address in it is safe by construction, only by a
; convention nobody had written down. FarRAM sat at $EF:0000 and was only
; harmless because the small data model never placed anything in it. WHY $C0
; AND NOT $D0. Two MB, not one, because the editor this exists for is a port
; of X16Edit and 2 MB is X16Edit's own design ceiling -- the reference
; implementation is the port's test oracle, and an oracle the port cannot
; match on file size stops being one. After bank $C0 goes to far data the
; editor's pool is 7,936 pages of 256 bytes against X16Edit's 8,128: within
; 2.4%, and no test file distinguishes them. The side effect is a simpler
; decode than a 1 MB version would have had: the whole reserved top is now
; banks $C0-$FF, i.e. cpu_a[23:22] == 2'b11. IT IS NOT WRITE-PROTECTED, and
; that distinction matters. The firmware guard in flat_sdram.sv is an EQUALITY
; on cpu_a[23:20] == 4'hF; widening it to cover $C0-$DF would break the
; editor, whose whole purpose here is to write this region. The two-bit test
; above is for documentation and assertions, never for the `we` path -- and
; per flat_sdram.sv's own header the protection compare must never enter the
; `ready` cone either way. RELEASABLE, ONE WAY, PER SESSION. Reserved at boot,
; so the safe case needs no action. K_MEM_RELEASE hands it to MEM_ALLOC and
; raises the ceiling K_MEM_TOP reports; `edit` then fails cleanly until the
; next reboot. Release cannot be undone, because a program that had already
; allocated into the region would otherwise have it taken back with no way to
; find out. NOTHING MAY BAKE THE BOUNDARY. Every allocator must ask K_MEM_TOP
; at run time. A compile-time constant is exactly the failure the framebuffer
; reservation was written to avoid -- an image built against the larger arena,
; run on a machine where the region is reserved, walks straight through it and
; says nothing.
X816_KDATA_BASE:  .equ    0xc00000             ; first byte of the region
X816_KDATA_LAST:  .equ    0xdfffff             ; last byte, inclusive -- one below the VERA2 framebuffer
X816_KDATA_SIZE:  .equ    0x200000             ; 2 MB
X816_KDATA_BANK:  .equ    0xc0                 ; the bank the region starts on
X816_KDATA_FAR:   .equ    0xc00000             ; bank $C0: the kernel's own far data (x816-kernel.scm FarRAM)
X816_EDIT_BASE:   .equ    0xc10000             ; banks $C1-$DF: the editor's page pool, after the far-data bank
X816_EDIT_LAST:   .equ    0xdfffff             ; last byte the editor may use
X816_EDIT_SIZE:   .equ    0x1f0000             ; 2,031,616 bytes = 7,936 pages of 256
KMEM_REGION_EDIT: .equ    0                    ; K_MEM_RELEASE region id 0 -- this whole region
KMEM_REGIONS:     .equ    1                    ; region ids defined

; ---- MEM_ALLOC arena -----------------------------------------------------
; The flat SDRAM the kernel hands out, doc/KERNEL.md 5.5. It starts at bank
; $20 because everything below is already claimed by somebody: bank $00 is
; BRAM, $01-$0F is the program image (x816-lib.scm's Code region), and $10-$1F
; is FarRAM and the EXEC staging area. Nothing here is a preference -- if the
; linker maps and this arena ever disagreed, a program's own `far` data and a
; kernel allocation would be the same bytes, which is silent. THE END OF THE
; ARENA IS NOT A CONSTANT ANY MORE, and that is the whole point of the pair
; below. It stops at $BF:FFFF while the kernel writable-data region is
; reserved and at $DF:FFFF once K_MEM_RELEASE has handed that region over --
; so X816_HEAP_END is the DEFAULT, X816_HEAP_END_MAX the released ceiling, and
; neither is what a program should compile in. Ask K_MEM_TOP. A baked boundary
; is the failure the framebuffer reservation was written to avoid, and it is
; silent: the image simply allocates through somebody else's memory.
X816_HEAP_TABLE:   .equ    0x200000            ; one page of kernel bookkeeping, never handed out
X816_HEAP_BASE:    .equ    0x200100            ; first byte MEM_ALLOC may return
X816_HEAP_END:     .equ    0xbfffff            ; last byte of the arena at boot -- stops below the kernel writable-data region
X816_HEAP_END_MAX: .equ    0xdfffff            ; last byte after K_MEM_RELEASE(KMEM_REGION_EDIT) -- stops below the VERA2 framebuffer
X816_HEAP_GRAIN:   .equ    0x100               ; allocations are rounded up, and start, on a page
X816_HEAP_BLOCKS:  .equ    32                  ; live allocations at once -- a fixed table, not a free list

; ---- Kernel error codes --------------------------------------------------
; Returned in C with carry SET. Zero is never an error, so a caller that only
; checks carry and a caller that checks the code agree.
KERR_NOSYS:    .equ    1                       ; call number not implemented in this build
KERR_NOTFOUND: .equ    2
KERR_NOSPACE:  .equ    3
KERR_BADARG:   .equ    4
KERR_IO:       .equ    5
KERR_EXISTS:   .equ    6
KERR_NOTEMPTY: .equ    7

; ---- I/O page, bank $00 page $9F -----------------------------------------
; Deliberately the same layout as the Commander X16 for $9F00-$9F7F so X16
; register offsets port over unchanged; $9F80-$9F8F is X816's own.
X816_IO_PAGE:        .equ    0x9f00            ; bank $00 only
X816_VIA1:           .equ    0x9f00
X816_VIA2:           .equ    0x9f10
X816_VERA:           .equ    0x9f20            ; $9F20-$9F3F
X816_YM:             .equ    0x9f40
X816_SYSCTL:         .equ    0x9f80            ; bit 0 boot overlay, bit 1 E flag (r/o), bit 2 turbo
X816_SYSCTL_LAST:    .equ    0x9f8f            ; end of the SYSCTL decode
X816_SYSCTL_OVERLAY: .equ    0x01              ; bit 0: boot ROM overlay enable
X816_SYSCTL_EMU:     .equ    0x02              ; bit 1: CPU E flag, read-only
X816_SYSCTL_TURBO:   .equ    0x04              ; bit 2: CPU speed, 0 = 8 MHz average (reset), 1 = 14 MHz
X816_SD_LBA:         .equ    0x9f81            ; $9F81-$9F84 block number, LE
X816_SD_MEM:         .equ    0x9f85            ; $9F85-$9F87 DMA address, LE (READ only)
X816_SD_COUNT:       .equ    0x9f88            ; blocks to transfer, 1-255
X816_SD_CMD:         .equ    0x9f89            ; WRITE ONLY. 1 READ 2 WRITE 3 READBUF 4 RESET
X816_SD_STATUS:      .equ    0x9f8a            ; READ ONLY. b0 busy, b1 error, b7 present
X816_SD_GAP:         .equ    0x9f8b            ; MUST STAY UNMAPPED -- see sd_block.sv
X816_SD_DATA:        .equ    0x9f8c            ; block-buffer window, auto-incrementing
X816_KBD_COUNT:      .equ    0x9f8d            ; keyboard diagnostic counters, $9F8D-$9F8F
X816_TIMER:          .equ    0x9f90            ; $9F90-$9F93 free-running ms counter, LE
X816_TIMER_LAST:     .equ    0x9f93            ; reading $9F90 latches bits 31:8
X816_TIMER_DIV:      .equ    14000             ; cpu_clk cycles per tick: 14 MHz / 14000 = 1 kHz exactly, in both SYSCTL[2] CPU speeds
X816_TIMER_HZ:       .equ    1000              ; so the unit is a millisecond
X816_BOOT_BASE:      .equ    0xff00            ; boot ROM read overlay, bank $00
X816_BOOT_SIZE:      .equ    0x100             ; and it is exactly one page

; ---- Fast program RAM (doc/MEMORY_MAP.md 1) ------------------------------
; Banks $01-$04 are BRAM, always. That is where the HPS loader drops a
; program, so a program's CODE is single-cycle without anything being rebuilt
; -- measured 4.47x against SDRAM on hardware, doc/AUDIT.md 6.2. There is no
; mode and no register: an earlier design made this block switchable with VERA
; and it could not be built (three synthesis failures; the attempt's records
; live in git history). VERA is a stock 128 KB instead, which pays for it.
X816_FAST_BASE:  .equ    0x010000              ; first byte of BRAM -- also X816_PROG_BASE, which is the point
X816_FAST_LAST:  .equ    0x04ffff              ; last byte, bank $04
X816_FAST_SIZE:  .equ    0x040000              ; 256 KB, four whole banks
X816_FAST_BANKS: .equ    4                     ; banks $01-$04
X816_VRAM_SIZE:  .equ    0x020000              ; VERA is stock 128 KB; it was 352 KB before the trade

; ---- Interrupt hardware --------------------------------------------------
; VERA's interrupt registers and the VIA's, by the offsets the stock X16 uses
; -- the I/O page is byte-for-byte the X16's for $9F00-$9F7F, so these are
; inherited rather than chosen. The kernel's dispatcher (runtime/kirq.s) is
; the one thing that has to know all of them at once, because it is the only
; code that sees an interrupt before anybody has said which device caused it.
X816_VERA_IEN:        .equ    0x9f26           ; VERA interrupt enable
X816_VERA_ISR:        .equ    0x9f27           ; VERA interrupt status; write 1 to clear
X816_VERA_IRQ_VSYNC:  .equ    1
X816_VERA_IRQ_LINE:   .equ    2
X816_VERA_IRQ_SPRCOL: .equ    4
X816_VERA_IRQ_AFLOW:  .equ    8                ; clears by REFILLING, not by ack
X816_VIA_IFR:         .equ    13               ; offset within a VIA: interrupt flags
X816_VIA_IER:         .equ    14               ; offset within a VIA: interrupt enable
X816_YM_TIMER_REG:    .equ    20               ; YM2151 register holding its IRQ resets

; ---- 65816 native vectors ------------------------------------------------
; Hardware addresses, not ours to place, and SIXTEEN bits wide -- which is the
; constraint that shapes doc/KERNEL.md section 5.6: the CPU jumps into bank
; $00 for every interrupt, so the kernel's first-level handler cannot live in
; the firmware region with the rest of the kernel. kirq_install stamps a
; four-byte `jmp long:` trampoline into bank $00 for each of these and points
; the vector at it. ABORT is listed because it must keep trapping: x816.sv
; ties abort_n high, so there is no ABORT source and nothing should install
; one.
X816_VEC_COP:   .equ    0x00ffe4
X816_VEC_BRK:   .equ    0x00ffe6
X816_VEC_ABORT: .equ    0x00ffe8               ; no source; stays trapping
X816_VEC_NMI:   .equ    0x00ffea
X816_VEC_IRQ:   .equ    0x00ffee

; ---- Interrupt vector slots ----------------------------------------------
; IRQ_SET's index space (doc/KERNEL.md section 5.6). One slot per SOURCE
; rather than one per CPU vector, because the CPU has a single IRQ vector and
; seven things behind it: deciding which fired is the dispatcher's job, and a
; program that wants the raster split should not have to also service the
; audio FIFO to get it. Slot numbers are ABI -- appending is fine, renumbering
; is not.
KIRQ_VSYNC:           .equ    0                ; VERA vertical blank
KIRQ_LINE:            .equ    1                ; VERA raster line compare
KIRQ_SPRCOL:          .equ    2                ; VERA sprite collision
KIRQ_AFLOW:           .equ    3                ; VERA audio FIFO low
KIRQ_VIA1:            .equ    4                ; VIA #1 -- timers, SNES pads, I2C to the SMC
KIRQ_VIA2:            .equ    5                ; VIA #2 -- user port
KIRQ_YM:              .equ    6                ; YM2151 timer
KIRQ_SPURIOUS:        .equ    7                ; an IRQ that no enabled source claimed
KIRQ_NMI:             .equ    8                ; SMC NMI request -- edge, nothing to acknowledge
KIRQ_BRK:             .equ    9                ; BRK
KIRQ_COP:             .equ    10               ; COP
KIRQ_SLOTS:           .equ    11               ; slots in the table
KIRQ_SLOT_SIZE:       .equ    4                ; bytes per slot: a 24-bit handler in a power-of-two stride, so the index scales with two shifts and not a multiply
KIRQ_TRAMPOLINE_SIZE: .equ    4                ; `jmp long:` -- opcode plus 24 bits

