; ============================================================================
; x816_contract.inc -- the X816 contract constants, for as65816.
;
; GENERATED BY tools/contract.py -- DO NOT EDIT.
; Edit X816_core/tools/contract.py and run:  python tools/contract.py --write
;
; The Calypsi assembler runs the C preprocessor, so this is #included, not
; .included, and the expressions are C-style. Every symbol here is a .equ:
; defining one of these names again in the including file is a duplicate
; symbol error, which is the point -- a second definition is exactly the
; drift this file exists to stop.
; ============================================================================

#ifndef X816_CONTRACT_INC
#define X816_CONTRACT_INC

; ---- Image and load contract ---------------------------------------------
; Where the HPS loader drops an image, what marks it as one, and where control
; is handed to it. boot/boot.s, x816.sv's download path, exec.s and every
; linker script have to agree on all of it or a load lands on the zero page
; and the machine dies before it prints anything.
X816_PROG_BASE:      .equ    0x010000          ; loadable program image: OSD 'Load Image' and boot1.rom
X816_PROG_ENTRY:     .equ    0x010004          ; PROG_BASE + 4 -- the jmp in the image's own header
X816_FW_BASE:        .equ    0xf00000          ; resident kernel firmware image, boot2.rom (doc/KERNEL.md 3)
X816_FW_ENTRY:       .equ    0xf00004          ; FW_BASE + 4
X816_FW_FIRST_BANK:  .equ    0xf0              ; banks $F0-$FF are the firmware region, write-protected
X816_MAGIC_0:        .equ    0x58
X816_MAGIC_1:        .equ    0x38
X816_MAGIC_2:        .equ    0x31
X816_MAGIC_3:        .equ    0x36
X816_MAGIC_LE32:     .equ    0x36313858        ; the same four bytes as one little-endian 32-bit read
X816_IOCTL_PROG:     .equ    0x0040            ; MiSTer ioctl_index for boot1.rom (a program image)
X816_IOCTL_FW:       .equ    0x0080            ; MiSTer ioctl_index for boot2.rom (the kernel firmware)
X816_IOCTL_OSD_SLOT: .equ    0x01              ; ioctl_index[5:0] for an OSD file pick
X816_EXEC_STAGE:     .equ    0x100000          ; where `run` parks an image before relocating it over PROG_BASE
X816_EXEC_MAX:       .equ    0xff00            ; largest image exec.s's single-pass copy can move (X is 16 bits)

; ---- Kernel ABI -- table, context and error codes ------------------------
; doc/KERNEL.md sections 3-5. The table address is fixed forever; the kernel's
; bank-0 claim is carved out of every program's linker map so a program object
; cannot land on the kernel's direct page.
KERN_TABLE:      .equ    0x00fe00              ; 64 entries of `jmp long:`, one page
KERN_ENTRIES:    .equ    64                    ; entries in the table
KERN_ENTRY_SIZE: .equ    4                     ; bytes per entry -- a jmp long:
KERN_TABLE_END:  .equ    0x00feff              ; last byte of the table page
KERN_DP:         .equ    0x2000                ; the kernel's direct page; KENTER switches D here
KERN_STATE:      .equ    0x2000                ; start of the kernel's bank-0 claim (KERNEL.md 3.1)
KERN_STATE_END:  .equ    0x2fff                ; last byte of the claim

; ---- MEM_ALLOC arena -----------------------------------------------------
; The flat SDRAM the kernel hands out, doc/KERNEL.md 5.5. It starts at bank
; $20 because everything below is already claimed by somebody: bank $00 is
; BRAM, $01-$0F is the program image (x816-lib.scm's Code region), and $10-$1F
; is FarRAM and the EXEC staging area. It stops below $F0 because that is the
; write-protected firmware. Nothing here is a preference -- if the linker maps
; and this arena ever disagreed, a program's own `far` data and a kernel
; allocation would be the same bytes, which is silent.
X816_HEAP_TABLE:  .equ    0x200000             ; one page of kernel bookkeeping, never handed out
X816_HEAP_BASE:   .equ    0x200100             ; first byte MEM_ALLOC may return
X816_HEAP_END:    .equ    0xefffff             ; last byte of the arena, inclusive
X816_HEAP_GRAIN:  .equ    0x100                ; allocations are rounded up, and start, on a page
X816_HEAP_BLOCKS: .equ    32                   ; live allocations at once -- a fixed table, not a free list

; ---- Kernel error codes --------------------------------------------------
; Returned in C with carry SET. Zero is never an error, so a caller that only
; checks carry and a caller that checks the code agree.
KERR_NOSYS:    .equ    1                       ; call number not implemented in this build
KERR_NOTFOUND: .equ    2
KERR_NOSPACE:  .equ    3
KERR_BADARG:   .equ    4
KERR_IO:       .equ    5
KERR_EXISTS:   .equ    6
KERR_NOTEMPTY: .equ    7

; ---- I/O page, bank $00 page $9F -----------------------------------------
; Deliberately the same layout as the Commander X16 for $9F00-$9F7F so X16
; register offsets port over unchanged; $9F80-$9F8F is X816's own.
X816_IO_PAGE:        .equ    0x9f00            ; bank $00 only
X816_VIA1:           .equ    0x9f00
X816_VIA2:           .equ    0x9f10
X816_VERA:           .equ    0x9f20            ; $9F20-$9F3F
X816_YM:             .equ    0x9f40
X816_SYSCTL:         .equ    0x9f80            ; bit 0 boot overlay, bit 1 E flag (r/o)
X816_SYSCTL_LAST:    .equ    0x9f8f            ; end of the SYSCTL decode
X816_SYSCTL_OVERLAY: .equ    0x01              ; bit 0: boot ROM overlay enable
X816_SYSCTL_EMU:     .equ    0x02              ; bit 1: CPU E flag, read-only
X816_SD_LBA:         .equ    0x9f81            ; $9F81-$9F84 block number, LE
X816_SD_MEM:         .equ    0x9f85            ; $9F85-$9F87 DMA address, LE (READ only)
X816_SD_COUNT:       .equ    0x9f88            ; blocks to transfer, 1-255
X816_SD_CMD:         .equ    0x9f89            ; WRITE ONLY. 1 READ 2 WRITE 3 READBUF 4 RESET
X816_SD_STATUS:      .equ    0x9f8a            ; READ ONLY. b0 busy, b1 error, b7 present
X816_SD_GAP:         .equ    0x9f8b            ; MUST STAY UNMAPPED -- see sd_block.sv
X816_SD_DATA:        .equ    0x9f8c            ; block-buffer window, auto-incrementing
X816_KBD_COUNT:      .equ    0x9f8d            ; keyboard diagnostic counters, $9F8D-$9F8F
X816_BOOT_BASE:      .equ    0xff00            ; boot ROM read overlay, bank $00
X816_BOOT_SIZE:      .equ    0x100             ; and it is exactly one page

