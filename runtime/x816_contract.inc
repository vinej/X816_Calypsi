K_CON_GETXY:   .equ    6
K_CON_PUTRAW:  .equ    7
K_FS_OPEN:     .equ    16
K_FS_CLOSE:    .equ    17
K_FS_READ:     .equ    18
K_FS_WRITE:    .equ    19
K_FS_SEEK:     .equ    20
K_FS_SIZE:     .equ    21
K_FS_DELETE:   .equ    22
K_FS_RENAME:   .equ    23
K_DIR_OPEN:    .equ    24
K_DIR_NEXT:    .equ    25
K_DIR_CLOSE:   .equ    26
K_FS_CHDIR:    .equ    27
K_FS_GETCWD:   .equ    28
